# AWS Configuration
AWS_REGION=ap-southeast-1
AWS_PROFILE=default

# Environment (dev, uat, prod)
ENVIRONMENT=dev

# Lambda Configuration
LAMBDA_MEMORY_SIZE=512
LAMBDA_TIMEOUT=120
LAMBDA_RESERVED_CONCURRENCY=8

# SQS Configuration
SQS_BATCH_SIZE=10
SQS_VISIBILITY_TIMEOUT=300
SQS_MAX_RECEIVES=3

# API Rate Limits
RATE_LIMIT_PER_MINUTE=1000
RATE_LIMIT_PER_DAY=100000

# EventBridge Schedule (cron format)
SCHEDULE_EXPRESSION="cron(0 0 * * ? *)"

# EODHD API Token (for local testing only - use Secrets Manager in AWS)
EODHD_API_TOKEN=your_api_token_here
